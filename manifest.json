{
  "manifest_version": 3,
  "name": "OReilly EPUB Downloader",
  "version": "1.0.0",
  "description": "Download EPUB from OReilly Learning you can read on web.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["https://learning.oreilly.com/*", "https://*.oreilly.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://learning.oreilly.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/jszip.min.js", "scripts/oreilly-api.js", "scripts/epub-builder.js"],
      "matches": ["https://learning.oreilly.com/*"]
    }
  ]
}
